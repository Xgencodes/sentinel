# Copy to .env and fill in.

PORT=3100
DATABASE_URL=postgres://user:password@localhost:5432/sentinel

# memory | (unset = log to stdout)
# Tests and the demo scenario use "memory" so a whole patient journey can be
# reconstructed by correlationId; leave unset for a running deployment.
TELEMETRY_MODE=

# Inference backend: mock | http (see src/model/model.module.ts)
INFERENCE_BACKEND=mock
MODEL_API_URL=
MODEL_API_KEY=
MODEL_BACKEND_ID=open-weights

# Africa's Talking SMS. Leave AT_API_KEY unset to use the mock SMS adapter —
# the whole delivery pipeline works with zero credentials (see
# src/delivery/delivery.module.ts). Only set these to send real SMS.
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=
AT_BASE_URL=
